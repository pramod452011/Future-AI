rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Default Deny — Zero-Trust Posture
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Helper Functions
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidPreferredLanguage(lang) {
      return lang is string && lang in ['Hindi', 'Hinglish', 'English'];
    }

    function isValidChatToolType(tool) {
      return tool is string
        && tool in ['ai_chat', 'ai_voice_assistant', 'ai_writer', 'ai_translator', 'ai_video', 'ai_music'];
    }

    function isValidUsageToolType(tool) {
      return tool is string
        && tool in [
          'ai_chat',
          'ai_voice_assistant',
          'ai_writer',
          'ai_translator',
          'ai_image',
          'ai_video',
          'ai_music',
          'ai_voice',
          'connection_test'
        ];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasOnly([
          'userId',
          'displayName',
          'email',
          'photoUrl',
          'preferredLanguage',
          'glowBoostEnabled',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'userId',
          'displayName',
          'email',
          'preferredLanguage',
          'glowBoostEnabled',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() <= 150
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && isValidPreferredLanguage(data.preferredLanguage)
        && data.glowBoostEnabled is bool
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidChatHistoryEntry(data, userId) {
      return data.keys().hasOnly([
          'userId',
          'title',
          'prompt',
          'response',
          'toolType',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'userId',
          'title',
          'prompt',
          'response',
          'toolType',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 140
        && data.prompt is string
        && data.prompt.size() >= 1
        && data.prompt.size() <= 4000
        && data.response is string
        && data.response.size() >= 1
        && data.response.size() <= 16000
        && isValidChatToolType(data.toolType)
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidGeminiUsageEvent(data, userId) {
      return data.keys().hasOnly([
          'userId',
          'toolType',
          'modelName',
          'promptChars',
          'responseChars',
          'createdAt'
        ])
        && data.keys().hasAll([
          'userId',
          'toolType',
          'modelName',
          'promptChars',
          'responseChars',
          'createdAt'
        ])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidUsageToolType(data.toolType)
        && data.modelName is string
        && data.modelName.size() >= 1
        && data.modelName.size() <= 60
        && data.promptChars is int
        && data.promptChars >= 0
        && data.promptChars <= 20000
        && data.responseChars is int
        && data.responseChars >= 0
        && data.responseChars <= 50000
        && isValidTimestamp(data.createdAt);
    }

    // =========================================================================
    // Private User Profile: /users/{userId}
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId);

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'email',
          'photoUrl',
          'preferredLanguage',
          'glowBoostEnabled',
          'updatedAt'
        ])
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(userId) && isOwner(userId);

      // =======================================================================
      // Private Cloud Chat History: /users/{userId}/chats/{chatId}
      // =======================================================================
      match /chats/{chatId} {
        allow get: if isValidId(userId) && isValidId(chatId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);

        allow create: if isValidId(userId)
          && isValidId(chatId)
          && isOwner(userId)
          && isValidChatHistoryEntry(incoming(), userId);

        allow update: if isValidId(userId)
          && isValidId(chatId)
          && isOwner(userId)
          && isValidChatHistoryEntry(incoming(), userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'prompt',
            'response',
            'updatedAt'
          ])
          && incoming().userId == existing().userId
          && incoming().toolType == existing().toolType
          && incoming().createdAt == existing().createdAt;

        allow delete: if isValidId(userId) && isValidId(chatId) && isOwner(userId);
      }

      // =======================================================================
      // Private Per-User Gemini Usage Tracking: /users/{userId}/usage/{eventId}
      // =======================================================================
      match /usage/{eventId} {
        allow get: if isValidId(userId) && isValidId(eventId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);

        allow create: if isValidId(userId)
          && isValidId(eventId)
          && isOwner(userId)
          && isValidGeminiUsageEvent(incoming(), userId);

        // Usage records are immutable audit logs; only create and account-delete are allowed
        allow update: if false;

        allow delete: if isValidId(userId) && isValidId(eventId) && isOwner(userId);
      }
    }
  }
}
